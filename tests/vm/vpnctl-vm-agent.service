[Unit]
Description=Disposable vpnctl VM test agent (guest only)
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
ConditionKernelCommandLine=vpnctl_vm_test

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/vpnctl-vm/guest_agent.py
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal+console

[Install]
WantedBy=multi-user.target
